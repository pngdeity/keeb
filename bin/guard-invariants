#!/usr/bin/env bash
# Guard the invariants that no unit test can reach.
#
# Some of this firmware's rules are structural, not behavioural: they are about
# what may *call* what, and a call site added later would break them without any
# test going red. `docs/AUDIT-fcis.md` records them as "enforced by convention";
# this script makes the convention checkable, so a future edit fails loudly here
# instead of silently re-entering a cycle that cost a flash cycle to find.
#
# Each guard names the rule, the document that explains it, and the failure mode
# it prevents. Run it before committing; CI runs it too.
#
# Usage:
#   ./bin/guard-invariants
#
# Exits non-zero if any guard fails.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"

WLS="qmk_firmware/keyboards/epomaker/epomaker_split65/wls"
status=0

fail() {
    echo "FAIL $1"
    echo "     $2"
    status=1
}

ok() { echo "OK   $1"; }

# --- F5: the USB line has exactly one driver ----------------------------------
#
# `wls_usb_connect` is the only thing that restarts (or tears down) the USB
# driver, and the transport owner owns it. If a second call site appears, that
# site re-derives `if (changed) wls_usb_connect(...)` on its own and can get the
# direction rule wrong -- which is the 2026-10-13 livelock (the board enumerated,
# self-detached and re-enumerated about once a second, forever).
# See `wls/wls_transport.h` (the invariant) and `docs/ADR-transport-authority.md`.
# Count *call expressions* only: a line whose code (before any trailing comment)
# invokes wls_usb_connect, excluding the definition in wls_usb.c. A leading `*`
# or `//` marks a prose line; the definition has a type before the name.
call_sites=$(rg -n 'wls_usb_connect\s*\(' "$WLS" --glob '*.c' \
    | rg -v ':[0-9]+:\s*(/\*|\*|//)' \
    | rg -v ':[0-9]+:\s*(void|bool|static|[A-Za-z_]+)\s+.*wls_usb_connect\s*\([^;]*\)\s*\{' \
    | wc -l)
if [ "$call_sites" -eq 1 ]; then
    ok "F5 wls_usb_connect has exactly one call site"
else
    fail "F5 wls_usb_connect has $call_sites call sites (want 1)" \
         "only wls/wls_transport.c's drive_line_for may drive the USB line"
    rg -n 'wls_usb_connect\s*\(' "$WLS" --glob '*.c' || true
fi

# --- F7: the core's device-index vocabulary matches the vendor enum -----------
#
# `transport_logic.c` keeps private copies of DEVS_USB/DEVS_BT1..5/DEVS_2G4 so
# the file stays free of the firmware include graph (and therefore host-testable,
# V1/V6). The risk is silent drift: the two definitions must agree and nothing
# fails if they diverge. Read both and compare.
# See `docs/AUDIT-fcis.md` "F7 -- the duplicated device-index vocabulary".
core_defs=$(rg -o '^#define HSM_DEVS_[A-Z0-9_]+\s+[0-9]+' "$WLS/transport_logic.c" | sed 's/#define //')
vendor_file="qmk_firmware/keyboards/linker/wireless/module.h"

# Parse the first enum in module.h into "NAME VALUE" lines.
vendor_enum=$(awk '
    /^enum/ {n=0; in_enum=1; next}
    in_enum && /};/ {in_enum=0; next}
    in_enum {
        line=$0
        gsub(/\/\/.*/,"",line); gsub(/,/,"",line); gsub(/^[ \t]+|[ \t]+$/,"",line)
        if (line ~ /=/) { split(line,a,"="); name=a[1]; gsub(/[ \t]/,"",name); val=a[2]+0; n=val; print name" "val }
        else if (line != "") { print line" "n }
        n++
    }
' "$vendor_file")

drift=0
while read -r name value; do
    [ -n "$name" ] || continue
    vname="${name#HSM_}"   # HSM_DEVS_USB -> DEVS_USB
    vendor_value=$(echo "$vendor_enum" | awk -v w="$vname" '$1 == w {print $2; exit}')
    if [ -z "$vendor_value" ]; then
        echo "     ${name}: no ${vname} in ${vendor_file}"
        drift=1
    elif [ "$value" != "$vendor_value" ]; then
        echo "     drift: ${name}=${value} but ${vname}=${vendor_value} in module.h"
        drift=1
    fi
done <<< "$core_defs"
if [ "$drift" -eq 0 ]; then
    ok "F7 HSM_DEVS_* matches the vendor DEVS_* enum"
else
    fail "F7 the core's device-index copies have drifted from module.h" \
         "update the HSM_DEVS_* defines in $WLS/transport_logic.c"
fi

# --- the sleep hook may not cut a live USB line -------------------------------
#
# The presleep hook ran a transport teardown that could cut the line the host was
# using, which detached the board mid-session. The resolution: the hook may only
# *route through the rail owner*, never drive the line itself.
# See `docs/FINDINGS.md` and the `notify_usb_device_state_change_kb` hook.
hook_file="qmk_firmware/keyboards/epomaker/epomaker_split65/epomaker_split65.c"
if rg -q 'notify_usb_device_state_change_kb' "$hook_file"; then
    if rg -n 'wls_usb_connect\s*\(' "$hook_file" | rg -v ':\s*(/\*|\*|//)' | rg -q .; then
        fail "the presleep/USB hook drives the USB line directly" \
             "it must route through the transport owner, not call wls_usb_connect"
    else
        ok "the presleep/USB hook does not drive the USB line directly"
    fi
else
    fail "notify_usb_device_state_change_kb is missing from $hook_file" \
         "the suspend hook is how host suspend is reported as an event"
fi

# --- the sleep state may not be writable from outside its own file ------------
#
# The 30 s dark board was a stop entered with the matrix already disabled, then
# REFUSED, so the only path that re-enables the matrix (LPWR_WAKEUP) was never
# reached. Rung 1 of the fix consulted the policy before the effect; rung 2 gave
# the rule a test. This guard is rung 3: the unsafe order is made *unwritable*.
#
# The state used to be exposed as a public `lpwr_set_state(state)` free-writer,
# so any of six other files could name LPWR_PRESLEEP directly and bypass the
# gate entirely. It is now a file-static `lpwr_transition()`; outside callers get
# only reads and `lpwr_request_wakeup()` (which can restore, never strand).
#
# The rule: nothing outside `lowpower.c` may name a low-power state as a write.
# A future edit that re-adds a public setter, or that writes `lpwr_state`
# directly, fails here rather than on the board.
# See `docs/STATE-MACHINE-stop-wake-split.md` section 6 (rung 3).
lpwr_c="qmk_firmware/keyboards/linker/wireless/lowpower.c"
lpwr_h="qmk_firmware/keyboards/linker/wireless/lowpower.h"

# (a) no public state setter declared in the header
if rg -n 'lpwr_set_state\s*\(' "$lpwr_h" | rg -v ':\s*(/\*|\*|//)' | rg -q .; then
    fail "lpwr_set_state is declared public again" \
         "the state must be writable only inside $lpwr_c (see rung 3)"
    rg -n 'lpwr_set_state\s*\(' "$lpwr_h" | rg -v ':\s*(/\*|\*|//)' || true
else
    ok "no public lpwr state setter in the header"
fi

# (b) the state variable and its transition helper are file-static
if rg -q '^static\s+void\s+lpwr_transition\s*\(' "$lpwr_c"; then
    ok "lpwr_transition is file-static (the unsafe order is unwritable)"
else
    fail "lpwr_transition is not a static function in $lpwr_c" \
         "the state machine must own its own transitions"
fi

# (c) no other firmware file writes the state
stray=$(rg -n 'lpwr_set_state\s*\(' qmk_firmware/keyboards --glob '*.c' --glob '*.h' \
    | rg -v '^\S+:[0-9]+:\s*(/\*|\*|//)' \
    | rg -v "lowpower\.(c|h):") || true
if [ -z "$stray" ]; then
    ok "no firmware file outside lowpower.c writes the low-power state"
else
    fail "a file outside lowpower.c writes the low-power state" \
         "route it through lpwr_request_wakeup() instead"
    echo "$stray"
fi

# --- frame ownership is arbitrated in the core, not by a line's position ------
#
# Every indicator painter writes the same matrix buffer in the same frame pass,
# so who is showing is a property of the ORDER the painters run in. That ordering
# used to BE the frame pass: it returned early at the line after the boot code,
# so a painter moved across that line silently changed ownership and nothing
# failed. Artifact 2 of docs/DETERMINATION.md II.3. The rule now lives in
# `wls_frame_owner_of()` / `wls_frame_owner_is_exclusive()` (indicator_logic),
# and the frame pass must consult it rather than testing the raw predicate.
#
# The rule: the frame pass gates on the arbiter, and the arbiter is asked with a
# fact computed without painting (the predicate itself computes its deadline).
# A future edit that reintroduces a bare `if (wls_indicator_boot_code_owns_matrix())`
# in the pass fails here rather than on the board.
# See `docs/STATE-MACHINE-indicator-ownership.md`.
kbd_c="qmk_firmware/keyboards/epomaker/epomaker_split65/epomaker_split65.c"
if rg -q 'wls_frame_owner_is_exclusive\s*\(\s*wls_frame_owner_of\s*\(' "$kbd_c"; then
    ok "the frame pass arbitrates ownership through the core"
else
    fail "the frame pass does not consult the frame-ownership arbiter" \
         "gate painters on wls_frame_owner_is_exclusive(wls_frame_owner_of(...))"
fi

if rg -n 'if\s*\(\s*wls_indicator_boot_code_owns_matrix\s*\(\s*\)\s*\)' "$kbd_c" >/dev/null; then
    fail "the frame pass still gates on the raw boot-code predicate" \
         "route the claim through the arbiter so the rule has one home"
else
    ok "the frame pass does not gate on the raw boot-code predicate"
fi

# --- the armed wake mask is derived from a checked attribution ----------------
#
# The WB32 EXTI reports by PAD NUMBER ALONE (`PAL_PAD(line) = line & 0x0F` in
# chibios-contrib WB32 GPIOv1), so two pins on different ports sharing a pad are
# indistinguishable to the wake classifier. This board therefore excludes UART
# from its armed mask (its traffic would defeat deep sleep) ONLY because UART's
# pad is also reachable through a code it arms. That rule -- an excluded code's
# pad must be covered -- was comment prose; it is now `lpwr_excluded_code_is_safe`
# (lowpower_logic) applied where the mask is built. Artifact 3 of
# docs/DETERMINATION.md II.3. The rule: the mask is computed through the
# predicate, not returned as a hand-written constant, so a wrong attribution
# fails toward arming the code instead of silently discarding wakes.
# See `docs/STATE-MACHINE-pad-attribution.md`.
wls_c="qmk_firmware/keyboards/epomaker/epomaker_split65/wls/wls.c"
if rg -q 'lpwr_excluded_code_is_safe\s*\(' "$wls_c"; then
    ok "the armed wake mask is built through lpwr_excluded_code_is_safe"
else
    fail "the armed wake mask is a hand-written constant again" \
         "derive it through lpwr_excluded_code_is_safe so an unsound exclusion arms the code"
fi

if rg -n 'uint32_t lpwr_wakeup_armed_mask\s*\(\s*void\s*\)\s*\{\s*return LPWR_WAKEUP' "$wls_c" >/dev/null; then
    fail "lpwr_wakeup_armed_mask returns a bare constant" \
         "route it through the attribution predicate (see docs/STATE-MACHINE-pad-attribution.md)"
else
    ok "lpwr_wakeup_armed_mask does not return a bare constant"
fi

# --- the transport decision reads intent, never the USB line's own state ------
#
# The ADR's invariant has two halves. The first (one call site, on a change only)
# is F5 above. This is the second: "nothing in the line's own state may cause a
# decision change". It is the half that CAUSED the 2026-10-13 livelock --
# `USB_ACTIVE` was an input to the decision, and driving the line (a consequence
# of the decision) restarts the driver, which clears `USB_ACTIVE`. The decision
# perturbed its own input, so the board re-decided forever at the enumeration
# cadence.
#
# The rule: the transport owner's inputs are intent (the switch, the persisted
# index) and event-delivered host facts, never a live read of the USB line. A
# future edit that adds `usb_connected_state()` to `hints()` re-closes the cycle
# with no test going red; it fails here instead.
# See `docs/ADR-transport-authority.md` (the invariant) and
# `docs/STATE-MACHINE-transport-authority.md`.
transport_c="qmk_firmware/keyboards/epomaker/epomaker_split65/wls/wls_transport.c"
if rg -n 'usb_connected_state|USB_ACTIVE\b|USB_DRIVER\.state|usbGetDriverState' "$transport_c" \
    | rg -v ':[0-9]+:\s*(/\*|\*|//)' | rg -q .; then
    fail "the transport owner reads the USB line's own state" \
         "inputs must be intent or event-delivered host facts, never a line read"
    rg -n 'usb_connected_state|USB_ACTIVE\b|USB_DRIVER\.state|usbGetDriverState' "$transport_c" | rg -v ':[0-9]+:\s*(/\*|\*|//)' || true
else
    ok "the transport decision reads no live USB-line state"
fi

# The predicate that states the rule must keep its home, so the rule is a
# checkable set rather than prose that can go stale. Check the DEFINITION in the
# core (a bare name match would also hit the header declaration), plus a caller.
if rg -q '^bool\s+hsm_transport_input_is_pure\s*\(' "$WLS/transport_logic.c" && rg -q 'hsm_transport_input_is_pure' "$WLS/transport_logic.h"; then
    ok "the input-purity rule has a home in the pure core"
else
    fail "the transport input-purity rule is not stated in the pure core" \
         "keep hsm_transport_input_is_pure in transport_logic so the alphabet is checkable"
fi

# --- the cross-half order has a LIVENESS home, not only a safety one ----------
#
# The S2 executor (`wls_sleep_order_open`) gives the slave's sleep order a SAFETY
# home: an order whose release is unreachable cannot be constructed. Nothing
# asserted the liveness half -- that a permitted order is *eventually* released.
# A master that sent 0xAA and then left the transport that carries 0xCC strands
# the slave exactly as before, one step later, and no test noticed: liveness is a
# property of time, and nothing owned "this order has been outstanding too long".
#
# The rule now has a home: `wls_sleep_order_outlived_release` in the pure core,
# the observable form of the fault (the master cannot see the slave; it can only
# see how long it has waited). D1 of `TODO.md` "Determination residue". This guard
# keeps the predicate from being deleted back to prose.
if rg -q '^bool\s+wls_sleep_order_outlived_release\s*\(' "$WLS/split_logic.c" && rg -q 'wls_sleep_order_outlived_release' "$WLS/split_logic.h"; then
    ok "the order-liveness rule has a home in the pure core"
else
    fail "the cross-half order's liveness rule is not stated in the pure core" \
         "keep wls_sleep_order_outlived_release in split_logic so 'an order outlived its release' is checkable"
fi

# --- the outstanding-order record has exactly one writer each way -------------
#
# The predicate above decides an order's liveness from its send time, so the
# shell must RECORD that time. It did not, which made the property determined in
# the core and unavailable at the seam -- the residue D1's row names. The record
# now has one send writer and one release writer; a second writer would file the
# same fact twice and the record would stop meaning exactly one order.
# See `docs/STATE-MACHINE-stop-wake-split.md` section 5 (the liveness row).
order_writers=$(rg -n 'wls_note_sleep_order_(sent|released)\s*\(' "$WLS" --glob '*.c' \
    | rg -v ':[0-9]+:\s*(/\*|\*|//)' \
    | rg -v ':[0-9]+:\s*(void|bool|static|[A-Za-z_]+)\s+.*wls_note_sleep_order_[a-z]+\s*\([^;]*\)\s*\{' \
    | wc -l)
if [ "$order_writers" -eq 2 ]; then
    ok "the outstanding-order record has one send writer and one release writer"
else
    fail "the outstanding-order record has $order_writers writer sites (want 2)" \
         "stamp wls_note_sleep_order_sent on the 0xAA send and _released on the 0xCC send"
    rg -n 'wls_note_sleep_order_(sent|released)\s*\(' "$WLS" --glob '*.c' || true
fi

# --- the release sender is gated by the handle, not a local early return ------
#
# D2. The 0xCC release had exactly one call site, behind a bare
# `if (wireless_get_current_devs() == DEVS_USB) return;` -- the same
# convention-not-precondition shape the executor removed for the order, one step
# along. The safety argument silently assumed the release is sent whenever one is
# reachable, and that assumption had no home. The release handle
# (`wls_sleep_release_open`) is now that home, taken by both relay sites.
# The rule this keeps: every `wls_split_send(...WAKEUP...)` /
# `...POWER_DOWN...)` in the shell is preceded by a release-handle gate, and the
# handle keeps its DEFINITION in the pure core so the rule cannot go stale.
# See `docs/STATE-MACHINE-stop-wake-split.md` section 5, and D2 of `TODO.md`.
if ! rg -q '^wls_sleep_order_t\s+wls_sleep_release_open\s*\(' "$WLS/split_logic.c"; then
    fail "the release gate is not stated in the pure core" \
         "keep wls_sleep_release_open in split_logic so the release rule is checkable"
else
    ok "the release gate has a home in the pure core"
fi

relay_ungated=$(rg -n 'wls_split_send\s*\(\s*WLS_SPLIT_CMD_(WAKEUP|POWER_DOWN)' "$WLS" --glob '*.c' \
    | rg -v ':[0-9]+:\s*(/\*|\*|//)' \
    | wc -l)
relay_gates=$(rg -n 'wls_sleep_release_permitted\s*\(' "$WLS/wls_lifecycle.c" \
    | rg -v ':[0-9]+:\s*(/\*|\*|//)' \
    | wc -l)
if [ "$relay_gates" -eq "$relay_ungated" ] && [ "$relay_ungated" -eq 2 ]; then
    ok "each relay send is gated by the release handle ($relay_gates gates, $relay_ungated sends)"
else
    fail "the relay sends and their release gates do not correspond ($relay_gates gates, $relay_ungated sends; want 2 and 2)" \
         "each wls_split_send(WAKEUP|POWER_DOWN) needs its own wls_sleep_release_open/_permitted gate"
    rg -n 'wls_split_send\s*\(\s*WLS_SPLIT_CMD_(WAKEUP|POWER_DOWN)|wls_sleep_release_permitted\s*\(' "$WLS" --glob '*.c' || true
fi

# Note: the relay SITES legitimately read the transport once to supply the
# handle's fact (`wls_sleep_release_open(!on_usb)`), exactly as the order path
# does. Forbidding that read would forbid stating the rule. What must hold is
# that no relay send goes UNGATED, which the check above pins; and that both
# endpoints take the same fact, which `the_order_and_the_release_cannot_disagree`
# pins in `tests/split_logic`. No further shell check is honest here.

# --- the presleep teardown is a stated rule, not a bare line-state test --------
#
# D5. The presleep hook (`wls_lifecycle.c`) performs the one line EFFECT decided
# by the line's own state: it tears the USB driver down before a stop and asks
# `USB_ACTIVE` whether that is safe. That read is DELIBERATE -- a host that
# enumerated and is talking must never be cut by a low-power action -- so the
# residue is the missing RULE, not the read, and the fix states the rule rather
# than forbidding it. `hsm_usb_teardown_is_safe(host_talking, driver_idle)` is the
# rule's home: a teardown is refused while the line is in use at either level. The
# presleep site must consult it, not re-derive `USB_DRIVER.state != USB_ACTIVE` as
# a bare test no test can reach. D5 of `TODO.md` "Determination residue";
# `docs/STATE-MACHINE-transport-authority.md` section 4.
if rg -q '^bool\s+hsm_usb_teardown_is_safe\s*\(' "$WLS/transport_logic.c" \
    && rg -q 'hsm_usb_teardown_is_safe' "$WLS/transport_logic.h"; then
    ok "the presleep teardown rule has a home in the pure core"
else
    fail "the presleep teardown rule is not stated in the pure core" \
         "keep hsm_usb_teardown_is_safe in transport_logic so 'may this line be torn down' is checkable"
fi

lifecycle_c="$WLS/wls_lifecycle.c"
if rg -q 'hsm_usb_teardown_is_safe\s*\(' "$lifecycle_c"; then
    ok "the presleep hook arbitrates through the core's teardown rule"
else
    fail "the presleep hook does not consult the teardown rule" \
         "gate it on hsm_usb_teardown_is_safe(...) rather than a bare USB_DRIVER.state != USB_ACTIVE test"
fi

# --- LED-index ownership has a home, and the cue consults it -------------------
#
# `wls_frame_owner_of()` arbitrates the FRAME; nothing arbitrated the LED. Two
# non-exclusive painters writing one index resolved by CALL ORDER, so the winner
# was a line number and moving a paint call changed the sight with nothing
# failing. D3/D4 of `TODO.md` "Determination residue". The rule now lives in
# `wls_led_painter_of` / `wls_led_painter_is_exclusive` / `wls_led_can_paint`
# (indicator_logic), and the at-rest channel cue asks it rather than testing the
# REJECT early-return positionally.
# See `docs/STATE-MACHINE-indicator-ownership.md`.
if rg -q '^wls_led_painter_t\s+wls_led_painter_of\s*\(' "$WLS/indicator_logic.c" \
    && rg -q 'wls_led_painter_of' "$WLS/indicator_logic.h"; then
    ok "the LED-index ownership rule has a home in the pure core"
else
    fail "the LED-index ownership rule is not stated in the pure core" \
         "keep wls_led_painter_of in indicator_logic so 'who owns index N' is checkable"
fi

# The cue must consult the core rule, not re-derive REJECT positionally. A future
# edit that reintroduces `if (hsm_link_state_of_md(...) == HSM_LINK_REJECT)
# return;` in `wls_indicator_channel_state` puts the arbitration back in a line's
# position; it fails here instead.
ind_c="qmk_firmware/keyboards/epomaker/epomaker_split65/wls/wls_indicator.c"
if rg -q 'wls_led_can_paint\s*\(' "$ind_c"; then
    ok "the at-rest channel cue arbitrates through the core's LED ownership"
else
    fail "the at-rest channel cue does not consult the LED-ownership arbiter" \
         "gate it on wls_led_can_paint(...) so the arbitration is the core's, not a line's position"
fi

if rg -n '==\s*HSM_LINK_REJECT\s*\)\s*(/\*.*\*/\s*)?\{\s*$' "$ind_c" >/dev/null; then
    fail "the channel cue still gates on a bare REJECT early-return" \
         "route the suppression through wls_led_can_paint so the rule has one home"
else
    ok "the channel cue does not gate on a bare REJECT early-return"
fi

exit "$status"
