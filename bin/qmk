#!/usr/bin/env bash
# Project-local qmk CLI.
#
# Runs the QMK CLI bundled in the pinned qmk_firmware submodule
# (lib/python/qmk) rather than any system- or PyPI-installed `qmk`.
#
# Why this exists: the tree ships the modern CLI (userspace, overlay_dir,
# compile), while the packaged `qmk` on PATH is the older 1.2.0. The build's
# Makefile uses `QMK_BIN := qmk`, so putting this wrapper first on PATH makes
# the whole build use the tree's CLI.
#
# The `-c` payload sets sys.argv[0] to "qmk" BEFORE importing milc: milc
# derives its program name (and therefore its config file, ~/.config/qmk/qmk.ini)
# from argv[0]. Without this it would look for "-c.ini" and never read the
# project's user.overlay_dir.
#
# Usage:  PATH="$PWD/bin:$PATH" make epomaker/epomaker_split65:nathan
#   or:   ./bin/qmk compile -kb epomaker/epomaker_split65 -km nathan
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TREE="$HERE/../qmk_firmware"
VENV="$HERE/../.venv"

export ORIG_CWD="${ORIG_CWD:-$PWD}"
export PYTHONPATH="$TREE/lib/python${PYTHONPATH:+:$PYTHONPATH}"

# The tree's CLI resolves requirements.txt and keyboards/ relative to CWD.
cd "$TREE"

RUNNER='import sys; sys.argv[0] = "qmk"; from qmk.cli import *; from milc import cli; cli()'

if [ -x "$VENV/bin/python" ]; then
    exec "$VENV/bin/python" -c "$RUNNER" "$@"
else
    exec python3 -c "$RUNNER" "$@"
fi
